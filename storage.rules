rules_version = '2';

// Firebase Storage rules for DailyHub attachments.
//
// Deploy with:  firebase deploy --only storage
//
// Each user can only read and write files under their own uid. Without this,
// Storage's default rules either block everything (attachments silently fail)
// or, if you loosened them, let any signed-in user read anyone's receipts.
service firebase.storage {
  match /b/{bucket}/o {

    match /attachments/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
